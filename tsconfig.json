{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "naturel-studio",
    "altair-furniture",
    "liberty-technology",
    "ai-telegram-editor",
    "cardai",
    "english-app",
    "irbis-mebel",
    "irbis-studio",
    "lucky-box",
    "lumen-clinic",
    "mafia-vero-concept",
    "ne-uveren-proveril",
    "redbull-concept",
    "tsar-dverey",
    "studio-celebrity"
  ]
}
